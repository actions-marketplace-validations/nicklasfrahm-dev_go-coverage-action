{
    "name": "go-coverage-action",
    "version": "1.0.0",
    "description": "Coverage reports for the Go programming language",
    "main": "index.js",
    "scripts": {
        "lint": "eslint .",
        "prettier": "prettier -c ./*.js",
        "prepare": "ncc build index.js -o dist --source-map --license licenses.txt",
        "all": "npm run lint && npm run prepare"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/nicklasfrahm-dev/go-coverage-action.git"
    },
    "keywords": [
        "GitHub",
        "Actions",
        "Golang",
        "Go",
        "Testing",
        "Coverage"
    ],
    "author": "nicklasfrahm",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/nicklasfrahm-dev/go-coverage-action/issues"
    },
    "homepage": "https://github.com/nicklasfrahm-dev/go-coverage-action#readme",
    "dependencies": {
        "@actions/core": "3.0.1",
        "@actions/github": "9.1.1",
        "execa": "10.0.1"
    },
    "devDependencies": {
        "@semantic-release/github": "12.0.10",
        "@vercel/ncc": "0.45.0",
        "eslint": "10.11.0",
        "prettier": "3.9.9",
        "semantic-release": "25.0.9"
    },
    "volta": {
        "node": "20.11.1"
    }
}
